# Anera V2 — required environment variables.
# Copy to .env and supply real values. NEVER commit populated secrets.
# Authority: docs/SECURITY-GUIDELINES.md §8, docs/DEPLOYMENT-OPERATIONS.md §3.

# PostgreSQL connection string (D36). Required.
DATABASE_URL=

# Session signing material (D37). Required from Milestone 4 onward.
# The application must fail closed if this is absent — no fallback value (IG-65).
SESSION_SECRET=
