# Anera V2 — required environment variables.
# Copy to .env and supply real values. NEVER commit populated secrets.
# Authority: docs/SECURITY-GUIDELINES.md §8, docs/DEPLOYMENT-OPERATIONS.md §3.

# PostgreSQL connection string (D36). Required.
DATABASE_URL=

# NOTE — SESSION_SECRET was removed in Milestone 4 and is no longer read by
# anything. It existed to sign the legacy HMAC session token; D37 sessions are
# opaque random identifiers looked up in PostgreSQL, so there is no signing
# material to protect and nothing to leak (IG-65 closed).

# Cross-origin front ends permitted to make credentialed /api requests, as a
# comma-separated list of exact origins. Leave empty for same-origin only,
# which is the correct value for local development and any deployment where
# the browser app and the API share an origin.
ANERA_ALLOWED_ORIGINS=
