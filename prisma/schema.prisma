// Anera V2 — Phase 1 foundation schema.
//
// Authority: docs/BACKEND-SCHEMA.md §2 (foundation tables), docs/DECISIONS.md
//            D36 (PostgreSQL + Prisma), D37 (database-backed sessions),
//            D28 (foreign keys required for reliable erasure).
//
// SCOPE: Phase 1 only. BACKEND-SCHEMA.md §2 rule 3 — "Do not create
// future-phase tables in the Phase 1 migration." Phase 2 tables (swipes,
// matches, blocks) and later tables are created by their owning phase.
//
// Every relation carries a real foreign key with explicit cascade behaviour.
// The MVP had foreign keys on only 2 of 10 models, which made account
// deletion unreliable (IG-12) and blocked D28.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Account identity and credentials.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  /// D37: bcrypt hash. NOT NULL in V2 — the MVP's nullable-password
  /// demo/seed accounts are DEPRECATED (IG-67).
  passwordHash    String
  emailVerifiedAt DateTime?
  /// Account lifecycle state. The enforcement ladder and its full value set
  /// are Phase 4 / OQ-TS08; Phase 1 uses only "active".
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  profile     Profile?
  preferences Preferences?

  @@index([status])
  @@map("users")
}

/// D37: server-side session. The HTTP-only cookie carries only the session
/// id; validity is decided here on every protected request. Deleting the row
/// revokes the session immediately — replacing the MVP's in-memory blocklist,
/// which was lost on every restart (IG-70).
model Session {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Public-facing profile.
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  /// Replaces the MVP's stored `age` integer, which was wrong the day after
  /// it was written. Age is derived, never stored (BACKEND-SCHEMA.md §2.1).
  birthDate   DateTime
  /// String, not a Prisma enum: the gender and intent value sets are
  /// unratified (OQ-B07, OQ-P01). Validation lives in the application layer
  /// until those are decided.
  gender      String
  bio         String   @default("")
  /// Free-text locality only. The location model — coordinates, precision and
  /// obfuscation — is OQ-B05 and is decided before Phase 2 discovery.
  city        String   @default("")
  intent      String   @default("")
  isOnboarded Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    Photo[]
  interests ProfileInterest[]

  @@index([city])
  @@map("profiles")
}

/// Profile photo. Media storage architecture is OQ-A03; `url` holds whatever
/// the chosen store returns. Local-disk serving (IG-18) is DEPRECATED.
model Photo {
  id        String   @id @default(cuid())
  profileId String
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("photos")
}

/// Normalised interests. Replaces the MVP's JSON-string column, which was
/// unqueryable and a parse-failure risk (BACKEND-SCHEMA.md §2.1).
model ProfileInterest {
  profileId String
  interest  String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, interest])
  @@index([profileId])
  @@map("profile_interests")
}

/// Discovery preferences. New in V2 — the MVP had no preference model, which
/// is why every user was shown to every other user regardless of gender or
/// preference (IG-16). Consumed by Phase 2 discovery.
model Preferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  minAge           Int      @default(18)
  maxAge           Int      @default(120)
  /// String, not an enum — see Profile.gender.
  genderPreference String   @default("")
  /// Inert until the location model is decided (OQ-B05). Nullable so Phase 1
  /// neither invents a distance semantic nor blocks on one.
  maxDistanceKm    Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("preferences")
}
